MESH_DB_PATH=./data/mesh-sports.sqlite

# Google OAuth web client. Register this exact callback URL in Google Cloud.
AUTH_BASE_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated member email addresses allowed to use /staff.
MESH_ADMIN_EMAILS=
